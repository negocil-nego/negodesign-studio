{
  "version": 1,
  "components": [
    {
      "id": "input-range",
      "name": "InputRange",
      "entry": {
        "Svelte": "ui/InputRange.svelte",
        "React": "ui/InputRange.tsx",
        "Vue": "ui/InputRange.vue",
        "Flutter": "ui/InputRange.dart"
      },
      "files": {
        "Svelte": [
          "data/types.ts"
        ],
        "React": [
          "data/types.ts"
        ],
        "Vue": [
          "data/types.ts"
        ],
        "Flutter": [
          "data/types.dart",
          "data/input_range_view_model.dart"
        ]
      },
      "dependencies": [],
      "assets": [],
