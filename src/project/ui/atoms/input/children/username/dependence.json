{
  "version": 1,
  "components": [
    {
      "id": "input-username",
      "name": "InputUsername",
      "entry": {
        "Svelte": "ui/InputUsername.svelte",
        "React": "ui/InputUsername.tsx",
        "Vue": "ui/InputUsername.vue",
        "Flutter": "ui/InputUsername.dart"
      },
      "files": {
        "Svelte": ["data/types.ts", "data/validation.ts"],
        "React": ["data/types.ts", "data/validation.ts"],
        "Vue": ["data/types.ts", "data/validation.ts"],
        "Flutter": ["data/types.dart"]
      },
      "dependencies": ["input-label"],
      "assets": {
        "Svelte": ["project/data/style.component.ts"],
        "React": ["project/data/style.component.ts"],
        "Vue": ["project/data/style.component.ts"],
        "Flutter": []
      },
      "props": [
        { "name": "labelProps", "type": "LabelProps", "required": false },
        { "name": "inputProps", "type": "InputProps", "required": true },
        { "name": "validationMode", "type": "UsernameValidationMode", "required": false },
        { "name": "errorMessage", "type": "string", "required": false },
        { "name": "onValueChange", "type": "(value: string) => void", "required": false },
        { "name": "onValidityChange", "type": "(isValid: boolean) => void", "required": false }
      ]
    }
  ]
}
