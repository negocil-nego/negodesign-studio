{
  "version": 1,
  "components": [
    {
      "id": "sidebar",
      "name": "Sidebar",
      "entry": {
        "Svelte": "ui/Sidebar.svelte",
        "React": "ui/Sidebar.tsx",
        "Vue": "ui/Sidebar.vue",
        "Flutter": "ui/Sidebar.dart"
      },
      "files": {
        "Svelte": [
          "data/types.ts",
          "shared/sidebar-item/ui/SidebarItem.svelte",
          "shared/sidebar-section/ui/SidebarSection.svelte",
          "shared/sidebar-profile/ui/SidebarProfile.svelte"
        ],
        "React": [
          "data/types.ts",
          "shared/sidebar-item/ui/SidebarItem.tsx",
          "shared/sidebar-section/ui/SidebarSection.tsx",
          "shared/sidebar-profile/ui/SidebarProfile.tsx"
        ],
        "Vue": [
          "data/types.ts",
          "shared/sidebar-item/ui/SidebarItem.vue",
          "shared/sidebar-section/ui/SidebarSection.vue",
          "shared/sidebar-profile/ui/SidebarProfile.vue"
        ],
        "Flutter": [
          "data/types.dart",
          "ui/flutter/sidebar_rail.dart",
          "shared/sidebar-item/ui/SidebarItem.dart",
          "shared/sidebar-section/ui/SidebarSection.dart",
          "shared/sidebar-profile/ui/SidebarProfile.dart",
          "data/viewmodel.dart"
        ]
      },
      "dependencies": {
        "Svelte": [
          "icon"
        ],
        "React": [
          "icon"
        ],
        "Vue": [
          "icon"
        ],
        "Flutter": []
      },
      "assets": {
        "Svelte": [],
        "React": [],
        "Vue": [],
        "Flutter": []
      },
      "props": [
        {
          "name": "variant",
          "type": "01 | 02 | 03 | 04",
          "required": false,
          "description": "Visual layout composition of the sidebar."
        },
        {
          "name": "theme",
          "type": "light | dark",
          "required": false,
          "description": "Light or dark color theme."
        },
        {
          "name": "collapsed",
          "type": "boolean",
          "required": false,
          "description": "Renders navigation in compact mode."
        },
        {
          "name": "sections",
          "type": "SidebarSectionProps[]",
          "required": false,
          "description": "Navigation groups and items."
        },
        {
          "name": "footerSections",
          "type": "SidebarSectionProps[]",
          "required": false,
          "description": "Pinned items displayed in the navigation footer."
        },
        {
          "name": "user",
          "type": "SidebarProfileProps",
          "required": false,
          "description": "User profile displayed in the footer."
        }
      ]
    }
  ]
}
