{
  "version": 1,
  "components": [
    {
      "id": "menu-simple",
      "name": "MenuSimple",
      "entry": {
        "Svelte": "ui/Menu.svelte",
        "React": "ui/Menu.tsx",
        "Vue": "ui/Menu.vue",
        "Flutter": "ui/Menu.dart"
      },
      "files": {
        "Svelte": [
          "data/types.ts"
        ],
        "React": [
          "data/types.ts"
        ],
        "Vue": [
          "data/types.ts"
        ],
        "Flutter": [
          "data/types.dart"
        ]
      },
      "dependencies": {
        "Svelte": [
          "button",
          "icon",
          "image",
          "menu-text",
          "submenu-grid-title",
          "submenu-sidebar-grid"
        ],
        "React": [
          "button",
          "icon",
          "image",
          "menu-text",
          "submenu-grid-title",
          "submenu-sidebar-grid"
        ],
        "Vue": [
          "button",
          "icon",
          "image",
          "menu-text",
          "submenu-grid-title",
          "submenu-sidebar-grid"
        ],
        "Flutter": [
          "button",
          "image",
          "menu-text",
          "submenu-grid-title",
          "submenu-sidebar-grid"
        ]
      },
      "assets": {
        "Svelte": [
          "components/local/data/style.component.ts"
        ],
        "React": [
          "project/data/style.component.ts"
        ],
        "Vue": [
          "project/data/style.component.ts"
        ],
        "Flutter": []
      },
      "props": [
        {
          "name": "logo",
          "type": "ImageProps",
          "required": false,
          "description": "Imagem ou marca apresentada à esquerda do menu."
        },
        {
          "name": "menus",
          "type": "(MenuTextProps | SubmenuGridTitleProps | SubmenuSidebarGridProps)[]",
          "required": false,
          "description": "Itens de navegação simples ou menus expansíveis em grelha ou com navegação lateral."
        },
        {
          "name": "buttonsProps",
          "type": "ButtonProps[]",
          "required": false,
          "description": "Botões de acção apresentados à direita."
        },
        {
          "name": "defaultOpenSubmenu",
          "type": "number | null",
          "required": false,
          "description": "Índice do submenu que inicia aberto."
        }
      ]
    }
  ]
}
