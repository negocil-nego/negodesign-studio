{
  "version": 1,
  "components": [
    {
      "id": "data-table",
      "name": "DataTable",
      "entry": {
        "Svelte": "ui/DataTable.svelte",
        "React": "ui/DataTable.tsx",
        "Vue": "ui/DataTable.vue",
        "Flutter": "ui/DataTable.dart"
      },
      "files": {
        "Svelte": ["data/types.ts", "data/examples.ts"],
        "React": ["data/types.ts", "data/examples.ts"],
        "Vue": ["data/types.ts", "data/examples.ts"],
        "Flutter": ["data/types.dart"]
      },
      "dependencies": {
        "Svelte": ["text", "icon", "data-table-filter"],
        "React": ["text", "icon", "data-table-filter"],
        "Vue": ["text", "icon", "data-table-filter"],
        "Flutter": ["data-table-filter"]
      },
      "assets": {
        "Svelte": ["project/data/style.component.ts"],
        "React": ["project/data/style.component.ts"],
        "Vue": ["project/data/style.component.ts"],
        "Flutter": []
      },
      "props": [
        {
          "name": "variant",
          "type": "\"01\" | \"02\" | \"03\" | \"04\" | \"05\"",
          "required": false,
          "description": "Variação visual e conjunto de dados de exemplo da tabela."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Título visível ou acessível da tabela."
        },
        {
          "name": "columns",
          "type": "TextProps[]",
          "required": false,
          "description": "Lista plana de cabeçalhos de coluna. Cada item é um TextProps { text, className? }."
        },
        {
          "name": "rows",
          "type": "TextProps[]",
          "required": false,
          "description": "Lista plana de todos os valores de célula, agrupados internamente pelo número de colunas."
        },
        {
          "name": "className",
          "type": "string",
          "required": false,
          "description": "Classes adicionais aplicadas ao elemento section."
        }
      ]
    }
  ]
}
